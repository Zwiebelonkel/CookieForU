# Local development: no Turso account required.
TURSO_DATABASE_URL=file:cookie-dev.db
TURSO_AUTH_TOKEN=
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000

# Production on Render: use your remote Turso libSQL database URL and token.
# TURSO_DATABASE_URL=libsql://YOUR-DATABASE-YOUR-ORG.turso.io
# TURSO_AUTH_TOKEN=YOUR_PRIVATE_DATABASE_TOKEN
# PUBLIC_BASE_URL=https://YOUR-SERVICE.onrender.com

# Optional, only if you keep the HTML frontend on a separate origin.
# CORS_ORIGIN=https://YOUR-USERNAME.github.io
